#!/bin/bash
set -e

if [ "$EUID" -eq 0 ]; then
    echo "CHYBA: Nespouštěj tento skript přes sudo!"
    echo "Spusť ho jako běžný uživatel: ./nazev_skriptu.sh"
    exit 1
fi

sudo -v
while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
done 2>/dev/null &

cat << EOF
##################################
# Na jaký počítač instalujete?   #
# Zbook = 1                      #
# Probook = 2                    #
# Mirantb = 3                    #
##################################
EOF
while true; do
    read -r -n 1 -p "Vyberte 1/2/3: " answer
    echo ""
    case "$answer" in
        1 )
            REPO="zbook"
            cat << EOF

###########################
# Zvolili jste Zbook...   #
###########################
EOF
            sleep 4
            break ;;
        2 )
            REPO="probook"
            cat << EOF

#############################
# Zvolili jste Probook...   #
#############################
EOF
            sleep 4
            break ;;
        3 )
            REPO="mirantb"
            cat << EOF

#############################
# Zvolili jste Mirantb...   #
#############################
EOF
            sleep 4
            break ;;
        * )
            echo -e "\nVyberte 1, 2, nebo 3" ;;
    esac
done

cat << EOF

#######################
# Instalace balíčků   #
#######################
EOF
sleep 2
sudo apt -y install \
    alacritty baobab brightnessctl btop cliphist curl evince fastfetch fd-find ffmpeg \
    firewall-applet firewalld fish font-manager fonts-inter fonts-jetbrains-mono fzf \
    galculator gawk geany gnome-characters gparted grimshot gvfs hplip-gui imagemagick jq \
    libnotify-bin libreoffice libreoffice-gnome libreoffice-l10n-cs libncurses-dev libxcb-cursor-dev libxkbcommon-dev \
    libwayland-dev mako-notifier mate-polkit nemo network-manager-applet nfs-common nwg-look \
    pamixer papirus-icon-theme pkg-config pavucontrol power-profiles-daemon qt6ct \
    resvg ripgrep ristretto rofi \
    simple-scan sway swaybg swayidle swaylock system-config-printer \
    udiskie udisks2 vainfo \
    waybar wayland-protocols wget wireplumber wl-clipboard wlsunset \
    xdg-desktop-portal-wlr xwayland youtubedl-gui zenity zoxide

cd "$HOME"
mkdir -p Dokumenty Videa Hudba Stažené Templates Public

        cat << EOF
####################################
# Probíhá konfigurace ${REPO}      #
####################################
EOF
        git clone --bare -b swaydebian https://github.com/lrestj/${REPO}.git "$HOME/.cfg.git"
        CFG=git --git-dir="$HOME/.cfg.git/" --work-tree="$HOME"
        ${CFG} checkout -f 

        cat << EOF

###################################
# Konfigurace git repozitářů...   #
###################################
EOF
        cd $HOME
        git config --global user.email "rest@seznam.cz"
        git config --global user.name "LrestJ"
        ${CFG} remote remove origin
        ${CFG} remote add github git@github.com:lrestj/${REPO}.git
        ${CFG} remote add gitlab git@gitlab.com:lrestj/${REPO}.git
        ${CFG} remote -v

        git clone https://github.com/lrestj/install "$HOME/.dotfiles/install/"
        cd "$HOME/.dotfiles/install/"
        git config --global user.email "rest@seznam.cz"
        git config --global user.name "LrestJ"
        git remote remove origin
        git remote add github git@github.com:lrestj/install.git
        git remote add gitlab git@gitlab.com:lrestj/install.git
        git remote -v

cat << EOF

################################
# Instalace prohlížeče Brave   #
################################
EOF
bash "$HOME/.local/bin/bravedeb"

cat << EOF

#######################################
# Autologin & firewall & swappiness   #
#######################################
EOF
sudo cp -rf "$HOME/.dotfiles/getty@tty1.service.d" /etc/systemd/system/
sudo systemctl enable firewalld.service
sudo mkdir -p /etc/sysctl.d
echo "vm.swappiness=10" | sudo tee /etc/sysctl.d/99-swappiness.conf
sudo cp -rv "$HOME/.dotfiles/journald.conf.d" /etc/systemd/

cat << EOF

###########################
# Nfs Synology settings   #
###########################
EOF
sudo cp -v /etc/fstab /etc/fstab.bak
cat "$HOME/.dotfiles/nfs2fstab.txt" | sudo tee -a /etc/fstab > /dev/null

cat << EOF

###################
# Grub settings   #
###################
EOF
sudo sed -i "11iGRUB_THEME=$HOME/.dotfiles/TelaGrubTheme/theme.txt" /etc/default/grub
sudo sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' /etc/default/grub
sudo sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=true/' /etc/default/grub
sudo cp -fv "$HOME/.dotfiles/40_custom" /etc/grub.d/
sudo update-grub

cat << EOF

############################
# APT sources update       #
############################
EOF
sleep 1
sudo cp -rf "$HOME/.dotfiles/sources.list.d" /etc/apt/
sudo rm /etc/apt/sources.list
sudo apt update
sudo apt install -y hyprpicker
bash "$HOME/.local/bin/vimbuild"

cat << EOF

#######################
# Installing Yazi     #
#######################
EOF
curl -fsSL https://yazi-rs.github.io/builds/yazi-keyring.gpg | sudo tee /usr/share/keyrings/yazi-keyring.gpg >/dev/null
echo "deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] https://yazi-rs.github.io/builds/ stable main" | sudo tee /etc/apt/sources.list.d/yazi.list >/dev/null
sudo apt update && sudo apt install -y yazi

cat << EOF

#######################
# NetworkManager fix  #
#######################
EOF
sleep 1
sudo sed -i 's/managed=false/managed=true/g' /etc/NetworkManager/NetworkManager.conf
sudo rm -rf /etc/network/
sudo apt -y remove ifupdown

cat << EOF

####################################
# Konec instalace                  #
# Restartovat do nového systému?   #
####################################
EOF
while true; do
    read -r -n 1 -p "Vyberte (A/N): " restart_answer
    echo ""
    case "$restart_answer" in
        [Aa]* )
            echo -e "\nRestartuji..."
            sleep 1
            sudo reboot
            break ;;
        [Nn]* )
            exit 0 ;;
        * )
            echo -e "\nVyberte A nebo N." ;;
    esac
done

