#!/bin/bash

set -e

cat << 'EOF'

##################################
# Na jaký počítač instalujete?   #
# Zbook = 1                      #
# Probook = 2                    #
# Mirantb = 3                    #
##################################
EOF

while true; do
    read -r -n 1 -p "Vyberte 1/2/3: " answer
    echo ""
    case "$answer" in
        1)
            REPO="zbook"
            cat << 'EOF'

###########################
# Zvolili jste Zbook...   #
###########################

EOF
            sleep 4
            break ;;
        2)
            REPO="probook"
            cat << 'EOF'

#############################
# Zvolili jste Probook...   #
#############################

EOF
            sleep 4
            break ;;
        3)
            REPO="mirantb"
            cat << 'EOF'

#############################
# Zvolili jste Mirantb...   #
#############################

EOF
            sleep 4
            break ;;
        *)
            echo "Vyberte 1, 2, nebo 3" ;;
    esac
done

  
mkdir Dokumenty Videa Hudba Stažené Templates

cat << 'EOF'
##########################
# Repozitář pro Install  #
##########################

EOF

git clone https://github.com/lrestj/install $HOME/.dotfiles/install/
cd $HOME/.dotfiles/install/
git config --global user.email "rest@seznam.cz"
git config --global user.name "LrestJ"
git remote remove origin
git remote add github git@github.com:lrestj/install.git
git remote add gitlab git@gitlab.com:lrestj/install.git
git remote -v

cat << EOF

######################################
# Probíhá konfigurace $REPO...       #
######################################
EOF

git clone --bare -b nirinixos "https://github.com/lrestj/${REPO}.git" "$HOME/.cfg.git"

CFG="git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME"
$CFG checkout -f

cp -fv /etc/nixos/hardware-configuration.nix $HOME/.dotfiles/nixos/hosts/${REPO}/
sudo nixos-rebuild switch --flake $HOME/.dotfiles/nixos#${REPO}

cat << 'EOF'

####################################
# Konfigurace git repozitářů ...   #
####################################
EOF

git config --global user.email "rest@seznam.cz"
git config --global user.name "LrestJ"
$CFG remote remove origin
$CFG remote add github git@github.com:lrestj/${REPO}.git
$CFG remote add gitlab git@gitlab.com:lrestj/${REPO}.git
$CFG remote -v

cat << 'EOF'

############################"
#  Konec instalace         #" 
#  Lze smazat /etc/nixos/  #" 
############################"
EOF

while true; do
    read -r -n 1 -p "Restartovat do nové konfigurace? (A/N): " answer
    case $answer in
        [Aa]* ) echo -e "\n Restartuji..."
                sleep 1
                systemctl reboot; break;;
        [Nn]* ) exit;;
        * ) echo -e "\nVyberte A nebo N.";;
    esac
done

